{
  "name": "mori-nest",
  "version": "0.0.0",
  "private": true,
  "description": "mori 하네스의 공유 기억 서버",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./transport": {
      "types": "./dist/transport/index.d.ts",
      "default": "./dist/transport/index.js"
    },
    "./control": {
      "types": "./dist/control/index.d.ts",
      "default": "./dist/control/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "22.19.2",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
